        <!-- Tech stack -->
        <mxCell id="78" value="&lt;b&gt;Tech Stack&lt;/b&gt;&lt;br&gt;• SQLAlchemy Core 2.x — dialect abstraction (not ORM); preserves ~2600 lines of hand-written SQL&lt;br&gt;• Alembic — schema versioning; advisory lock for concurrent multi-node migration safety&lt;br&gt;• PyMySQL (pure Python) — no C extension; works on s390x IBM Z architecture&lt;br&gt;• _CompatRow wrapper — allows row[0] (positional) and row[&apos;col&apos;] (named) access on SQLAlchemy Row"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;strokeWidth=1;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="1330" y="782" width="1850" height="96" as="geometry" />
        </mxCell>

