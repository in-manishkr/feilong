        <!-- compute_node_id Resolution panel -->
        <mxCell id="58" value="&lt;b&gt;compute_node_id  Resolution  (once at startup in get_engine())&lt;/b&gt;&lt;br&gt;Priority 1: CONF.database.compute_node_id  — explicit operator override&lt;br&gt;Priority 2: vmcp query userid  →  &quot;USERID@ZVM_SYSTEM&quot;  (z/VM guest only)&lt;br&gt;Priority 3: CONF.network.my_ip  (always-available — required=True config field)&lt;br&gt;Result stored in _COMPUTE_NODE_ID global — all operators call get_compute_node_id()"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1;strokeDasharray=5 3;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
