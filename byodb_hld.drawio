        <mxCell id="86" value="✓  Ready to serve requests"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B5E20;strokeColor=none;fontSize=12;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="1108" width="540" height="28" as="geometry" />
        </mxCell>

        <mxCell id="87" value="• register_compute_node() uses UPSERT — idempotent on restart&lt;br&gt;• check_stale_nodes() swallows all exceptions — startup must not fail&lt;br&gt;• _MIGRATION_LOCK serialises concurrent Alembic callers in-process&lt;br&gt;• deregister_compute_node() on clean shutdown (sets status=inactive)&lt;br&gt;• Stale: NOW()-INTERVAL :s SECOND (MariaDB) / datetime(&apos;now&apos;,&apos;-Ns&apos;) (SQLite)&lt;br&gt;• Pool event listeners track lifetime_checked_out/invalidated counters&lt;br&gt;• _CONN_LOCAL (thread-local): nested get_connection() reuses same txn"
          style="text;html=1;strokeColor=#B0BEC5;fillColor=#FAFAFA;align=left;verticalAlign=top;fontSize=9;fontColor=#37474F;spacingLeft=8;spacingTop=6;rounded=1;"
          vertex="1" parent="1">
          <mxGeometry x="20" y="1148" width="540" height="130" as="geometry" />
        </mxCell>

        <!-- ─── CENTER BOTTOM: Security & Config ─── -->
        <mxCell id="90" value="SECURITY,  CREDENTIALS  &amp;  CONFIGURATION"
          style="text;html=1;strokeColor=none;fillColor=#263238;align=center;fontColor=#ECEFF1;fontSize=12;fontStyle=1;verticalAlign=middle;rounded=1;"
          vertex="1" parent="1">
          <mxGeometry x="580" y="1010" width="720" height="24" as="geometry" />
        </mxCell>

        <mxCell id="91" value="&lt;b&gt;TLS / SSL&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;ssl_ca   = ca-cert.pem&lt;br&gt;ssl_cert = client-cert.pem&lt;br&gt;ssl_key  = client-key.pem&lt;/font&gt;&lt;br&gt;Verify: SHOW STATUS &apos;Ssl_cipher&apos;&lt;br&gt;require_secure_transport=ON&lt;br&gt;mTLS supported (client cert)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;"
          vertex="1" parent="1">
          <mxGeometry x="580" y="1044" width="224" height="110" as="geometry" />
        </mxCell>
        <mxCell id="92" value="&lt;b&gt;Credential Hardening&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;ZVMSDK_DB_PASSWORD&lt;/font&gt; env var&lt;br&gt;config wins if set; env = fallback&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;URL.create()&lt;/font&gt; — %-encode pw&lt;br&gt;password never in log output&lt;br&gt;bandit: 0 medium/high findings&lt;br&gt;5 low # nosec with justification"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;"
          vertex="1" parent="1">
          <mxGeometry x="814" y="1044" width="224" height="110" as="geometry" />
        </mxCell>
        <mxCell id="93" value="&lt;b&gt;Pool Monitoring&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;get_pool_status()&lt;/font&gt;&lt;br&gt;pool_size, checked_out, overflow&lt;br&gt;lifetime_checked_out/checked_in&lt;br&gt;lifetime_invalidated counter&lt;br&gt;pool_pre_ping=True (MariaDB)&lt;br&gt;event.listens_for on checkout"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;"
          vertex="1" parent="1">
          <mxGeometry x="1048" y="1044" width="252" height="110" as="geometry" />
        </mxCell>

        <mxCell id="94" value="&lt;b&gt;zvmsdk.conf  [database]  —  17+ New Options&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&quot;font-size:8px;font-family:Courier New;&quot;&gt;&lt;tr&gt;&lt;td&gt;backend = sqlite | mariadb | mysql&lt;/td&gt;&lt;td&gt;pool_size         = 5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;mode    = local | remote&lt;/td&gt;&lt;td&gt;pool_max_overflow = 10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;host / port / name / user / password&lt;/td&gt;&lt;td&gt;pool_timeout      = 30&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;compute_node_id  (auto-detected)&lt;/td&gt;&lt;td&gt;pool_recycle      = 3600&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;dir  (SQLite file directory)&lt;/td&gt;&lt;td&gt;connection  (full SQLAlchemy URL)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ssl_ca / ssl_cert / ssl_key&lt;/td&gt;&lt;td&gt;alembic_config  (optional override)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;strokeWidth=1;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="580" y="1164" width="720" height="158" as="geometry" />
