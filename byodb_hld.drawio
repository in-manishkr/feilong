        <mxCell id="101" value="&lt;b&gt;Source  (never modified)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;sdk_network.sqlite&lt;br&gt;sdk_guest.sqlite&lt;br&gt;sdk_image.sqlite&lt;br&gt;sdk_fcp.sqlite&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:8px;color:#E65100;&quot;&gt;4 old per-domain files&lt;/i&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="1330" y="1044" width="530" height="110" as="geometry" />
        </mxCell>
        <mxCell id="102" value="&lt;b&gt;Migration Script&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;migrate_sqlite_to_mariadb.py&lt;br&gt;--sqlite-dir  (source path)&lt;br&gt;--target-backend  sqlite|mariadb&lt;br&gt;--compute-node-id  (injected)&lt;br&gt;--dry-run  (counts only)&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;color:#E65100;&quot;&gt;INSERT IGNORE  |  batch=500&lt;/i&gt;"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=3;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="1910" y="1044" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="103" value="&lt;b&gt;Target&lt;/b&gt;&lt;br&gt;• New consolidated SQLite, OR&lt;br&gt;• Centralized MariaDB/MySQL&lt;br&gt;• Schema auto-upgraded (Alembic)&lt;br&gt;• Row count verified per table&lt;br&gt;• Idempotent — safe to re-run&lt;br&gt;• Exit 1 on count mismatch"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="2550" y="1044" width="630" height="110" as="geometry" />
        </mxCell>

        <mxCell id="104" value="• SOURCE_MAP: per-table column mapping with src_cols + tgt_cols (including compute_node_id)&lt;br&gt;• _inject_node_id(): stamps every migrated row — image rows always get &apos;GLOBAL&apos;&lt;br&gt;• Source SQLite files NEVER modified — re-running with INSERT IGNORE skips already-migrated rows"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#455A64;strokeWidth=1;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="1330" y="1164" width="1850" height="62" as="geometry" />
        </mxCell>
        <mxCell id="105" value="&lt;b&gt;Backward Compatibility Guarantee&lt;/b&gt;&lt;br&gt;✓ Default: backend=sqlite, mode=local — existing deployments need ZERO config changes&lt;br&gt;✓ SQLite path uses StaticPool — identical behavior to legacy sqlite3 single-connection pattern&lt;br&gt;✓ compute_node_id stored in all rows but local mode never uses it in WHERE clauses&lt;br&gt;✓ Rollback: set backend=sqlite in zvmsdk.conf and restart — source SQLite files untouched"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;fontSize=9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#2E7D32;"
